// URL Shortener SaaS — PostgreSQL schema
// Partial unique indexes: see database/prisma/migrations/README.md

generator client {
  provider = "prisma-client-js"
  // Monorepo: Express app imports @prisma/client from backend/node_modules
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum UrlStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum AliasStatus {
  ACTIVE
  GRACE
  RELEASED
  BLOCKED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id             String       @id @default(uuid()) @db.Uuid
  email          String       @unique
  name           String?
  profilePicture String?      @map("profile_picture") @db.Text
  authProvider   AuthProvider @map("auth_provider")
  googleId       String?      @unique @map("google_id")
  appleId        String?      @unique @map("apple_id")
  passwordHash   String?      @map("password_hash") @db.Text
  stripeCustomerId String?    @unique @map("stripe_customer_id")
  emailVerified    Boolean      @default(false) @map("email_verified")
  verifiedAt       DateTime?    @map("verified_at") @db.Timestamptz(6)
  otpCode          String?      @map("otp_code")
  otpExpiresAt     DateTime?    @map("otp_expires_at") @db.Timestamptz(6)
  otpSentAt        DateTime?    @map("otp_sent_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  urls            Url[]
  aliases         Alias[]          @relation("AliasOwner")
  subscriptions   Subscription[]
  authSessions    AuthSession[]
  dailyUrlUsages  DailyUrlUsage[]
  passwordResetTokens PasswordResetToken[]

  @@index([deletedAt])
  @@map("users")
}

model Url {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  originalUrl        String    @map("original_url") @db.Text
  shortCode          String    @unique @map("short_code")
  qrCodeUrl          String?   @map("qr_code_url") @db.Text
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  status             UrlStatus @default(ACTIVE)
  autoRenew          Boolean   @default(false) @map("auto_renew")
  lastRenewedAt      DateTime? @map("last_renewed_at") @db.Timestamptz(6)
  linkPasswordHash   String?   @map("link_password_hash") @db.Text
  clickCount         Int       @default(0) @map("click_count")
  creatorIp          String    @map("creator_ip") @db.Inet
  creatorUserAgent   String?   @map("creator_user_agent") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  clicks       Click[]
  boundAliases Alias[] @relation("AliasCurrentUrl")

  @@index([userId, createdAt(sort: Desc)])
  @@index([creatorIp, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([status])
  @@index([deletedAt])
  @@map("urls")
}

model Alias {
  id               String      @id @default(uuid()) @db.Uuid
  alias            String      @unique
  currentUrlId     String?     @unique @map("current_url_id") @db.Uuid
  firstUsedAt      DateTime    @map("first_used_at") @db.Timestamptz(6)
  lastUsedAt       DateTime    @map("last_used_at") @db.Timestamptz(6)
  graceExpiresAt   DateTime?   @map("grace_expires_at") @db.Timestamptz(6)
  reuseAllowed     Boolean     @default(false) @map("reuse_allowed")
  reuseAfter       DateTime?   @map("reuse_after") @db.Timestamptz(6)
  status           AliasStatus @default(ACTIVE)
  createdByUserId  String      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)

  createdBy  User  @relation("AliasOwner", fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentUrl Url?  @relation("AliasCurrentUrl", fields: [currentUrlId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([status])
  @@index([graceExpiresAt])
  @@index([reuseAfter])
  @@index([deletedAt])
  @@map("aliases")
}

model Click {
  id         BigInt   @id @default(autoincrement())
  urlId      String   @map("url_id") @db.Uuid
  ipAddress  String   @map("ip_address") @db.Inet
  country    String?
  city       String?
  deviceType String?  @map("device_type")
  browser    String?
  referrer   String?  @db.Text
  os         String?  @map("os")
  userAgent  String?  @map("user_agent") @db.Text
  clickedAt  DateTime @default(now()) @map("clicked_at") @db.Timestamptz(6)

  url Url @relation(fields: [urlId], references: [id], onDelete: Restrict)

  @@index([urlId, clickedAt(sort: Desc)])
  @@index([clickedAt])
  @@map("clicks")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  stripeSessionId      String             @unique @map("stripe_session_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  amount               Int
  currency             String             @db.Char(3)
  status            SubscriptionStatus @default(PENDING)
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(6)
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt(sort: Desc)])
  @@index([userId, status])
  @@map("subscriptions")
}

model AuthSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash") @db.Text
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model DailyUrlUsage {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  creatorIp  String?  @map("creator_ip") @db.Inet
  usageDate  DateTime @map("usage_date") @db.Date
  count      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
  @@unique([creatorIp, usageDate])
  @@map("daily_url_usage")
}
